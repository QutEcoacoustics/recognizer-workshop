{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
        "name": "Python: Attach to Panel App",
        "type": "python",
        "request": "attach",
        "connect": {
            "host": "localhost",
            "port": 5678
        },
        "pathMappings": [
            {
                "localRoot": "${workspaceFolder}",
                "remoteRoot": "${workspaceFolder}"
            }
        ]
    },
    {
        "name": "Panel: Run with Autoreload",
        "type": "python",
        "request": "launch",
        // This tells VS Code to run the script directly,
        // which correctly handles the sys.path modifications.
        "program": "${workspaceFolder}/scripts/run_server.py",
        "args": [],
        "jinja": true,
        "justMyCode": true 
    },

    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Debug Tests",
      "type": "python",
      "request": "test",                 // special request for test debugging
      "purpose": ["debug-test"],         // makes the Testing pane use THIS config
      "justMyCode": false,               // <— allow stepping into libraries
      "debugStdLib": false,              // set true if you also want to step into stdlib
      "console": "integratedTerminal"    // optional, nicer I/O
    }
  ]
}